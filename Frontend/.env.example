# Copy this file to .env and adjust if your backend isn't on the default port.
#   cp .env.example .env
#
# Not required for local dev — vite.config.ts already proxies /api requests
# to http://localhost:4000. Set this explicitly for production builds, or if
# your backend runs on a different host/port.
VITE_API_BASE_URL=http://localhost:4000/api
